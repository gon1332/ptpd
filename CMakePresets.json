{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ut",
      "description": "Unit Tests",
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "generator": "Ninja",
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "WSL"
        }
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ut",
      "configurePreset": "ut",
      "targets": ["test_time_ops"]
    }
  ],
  "testPresets": [
    {
      "name": "ut",
      "configurePreset": "ut",
      "execution": {
        "stopOnFailure": false
      },
      "output": {
        "verbosity": "extra"
      }
    }
  ]
}
